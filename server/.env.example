# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/github_assistant?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Google Gemini API Key for Embeddings (text-embedding-004) & LLM (gemini-1.5-flash)
GEMINI_API_KEY="your-gemini-api-key"

# GitHub Personal Access Token (for Octokit API)
GITHUB_TOKEN="your-github-token"

# Pinecone Vector Database
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX="github-assistant-index"
PINECONE_ENVIRONMENT="us-east-1"
